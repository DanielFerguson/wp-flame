{
    "name": "wp-flame/wp-flame",
    "description": "WordPress APM plugin with interactive flame graph",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-coding-standards/wpcs": "^3.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "WPFlame\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPFlame\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --configuration=quality/phpstan.neon.dist --memory-limit=1G --no-progress --debug",
        "analyse:baseline": "phpstan analyse --configuration=quality/phpstan.neon.dist --generate-baseline=quality/phpstan-baseline.neon --memory-limit=1G --no-progress --debug",
        "coverage:baseline": "@php bin/check-coverage-baseline.php build/logs/clover.xml --write-baseline",
        "lint": "bash bin/lint-php.sh",
        "standards": "@php bin/check-phpcs-baseline.php",
        "standards:baseline": "@php bin/check-phpcs-baseline.php --write-baseline",
        "test:coverage": [
            "@php -d pcov.enabled=1 -d pcov.directory=src vendor/bin/phpunit --testsuite unit --coverage-clover build/logs/clover.xml",
            "@php bin/check-coverage-baseline.php build/logs/clover.xml"
        ],
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "WP_TESTS_DIR=/tmp/wordpress-tests-lib phpunit --testsuite integration",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
