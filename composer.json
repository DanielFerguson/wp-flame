{
    "name": "wp-flame/wp-flame",
    "description": "WordPress APM plugin with interactive flame graph",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "WPFlame\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPFlame\\Tests\\": "tests/"
        }
    }
}
